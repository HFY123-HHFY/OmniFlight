# =========================
# OmniLayer Git Ignore Rules
# =========================

# CMake / Ninja build outputs
/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/build.ninja
**/.ninja_deps
**/.ninja_log
**/.cmake/

# Generated firmware and map outputs
*.elf
*.hex
*.bin
*.map
*.axf
*.lnp
*.htm

# Compiler intermediate files
*.o
*.obj
*.d
*.dep
*.crf
*.lst

# VS Code runtime logs (keep project config files)
.vscode/*.log
.vscode/*.log.lock

# OS temp files
.DS_Store
Thumbs.db
